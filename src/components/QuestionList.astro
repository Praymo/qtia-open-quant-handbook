---
import Badges from './Badges.astro';
import Icon from './Icon.astro';
import { url } from '../lib/site';
import type { Question } from '../lib/catalog';
const { questions } = Astro.props as { questions: Question[] };
---
<div class="question-list">
  {questions.map(question => <article class="question-row" data-question data-category={question.data.category} data-week={question.data.week} data-difficulty={question.data.difficulty} data-tags={JSON.stringify(question.data.tags)} data-date={question.data.date} data-id={question.data.id}>
    <span class="question-id mono">{question.data.id}</span>
    <div class="question-info"><h3><a href={url(`/questions/${question.data.id}/`)}>{question.data.title}</a></h3><p class="question-en">{question.data.titleEn}</p><p class="question-summary">{question.data.summary}</p><Badges question={question}/></div>
    <a class="row-arrow" href={url(`/questions/${question.data.id}/`)} aria-label={`阅读 ${question.data.title}`}><Icon name="chevron" size={18}/></a>
  </article>)}
</div>
