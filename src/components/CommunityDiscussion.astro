---
import snapshot from '../data/community-answers.json';
import { questionDiscussionUrl } from '../lib/site';
import { renderCommunityComment } from '../lib/render-community-comment.mjs';
const { questionId } = Astro.props;
type Entry = { author: string; avatar: string; body: string; createdAt: string; reactions: number; url: string; replies: number };
type Thread = { question: string; url: string; entries: Entry[] };
const current = (snapshot.questionDiscussions as Thread[]).filter(thread => thread.question === questionId);
const legacy = (snapshot.discussions as Thread[]).filter(thread => thread.question === questionId);
const entries = [...current.flatMap(thread => thread.entries.map(entry => ({ ...entry, threadUrl: thread.url }))), ...legacy.flatMap(thread => thread.entries.map(entry => ({ ...entry, threadUrl: thread.url })))].sort((a, b) => b.createdAt.localeCompare(a.createdAt));
---
<section class="discussion-section" id="discussion" aria-labelledby="discussion-title">
  <h2 class="article-section-title" id="discussion-title"><span>03</span>社区讨论 <small>{entries.length}</small></h2>
  {snapshot.updatedAt && <p class="poll-help">讨论更新于 {new Date(snapshot.updatedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' })}</p>}
  <p class="section-description">想法和完整的 Markdown 答案都可以贴在讨论区。希望解法单独展示在“社区解答”，也可以提交 PR 供审核。</p>
  <a class="button primary discussion-start" href={questionDiscussionUrl(questionId)}>直接贴答案或参与讨论 <span aria-hidden="true">↗</span></a>
  {entries.length ? <div class="discussion-list">
    {entries.slice(0, 3).map(entry => <article class="discussion-entry">
      <img src={entry.avatar || `https://github.com/${entry.author}.png?size=80`} width="34" height="34" alt="" loading="lazy"/>
      <div class="discussion-content"><div class="discussion-meta"><a href={`https://github.com/${entry.author}`}>@{entry.author}</a><time datetime={entry.createdAt}>{entry.createdAt.slice(0, 10)}</time></div><div class="discussion-body prose" set:html={renderCommunityComment(entry.body)} /><div class="discussion-actions"><a href={entry.url} aria-label={`在 GitHub 为 ${entry.author} 的内容点赞`}>{entry.reactions} 个反应 · 去 GitHub 点赞 ↗</a><a href={entry.threadUrl}>{entry.replies ? `${entry.replies} 条回复 · ` : ""}查看讨论 ↗</a></div></div>
    </article>)}
    {entries.length > 3 && <details class="discussion-more"><summary>展开其余 {entries.length - 3} 条讨论</summary>{entries.slice(3).map(entry => <article class="discussion-entry"><img src={entry.avatar || `https://github.com/${entry.author}.png?size=80`} width="34" height="34" alt="" loading="lazy"/><div class="discussion-content"><div class="discussion-meta"><a href={`https://github.com/${entry.author}`}>@{entry.author}</a><time datetime={entry.createdAt}>{entry.createdAt.slice(0, 10)}</time></div><div class="discussion-body prose" set:html={renderCommunityComment(entry.body)} /><div class="discussion-actions"><a href={entry.url}>{entry.reactions} 个反应 · 去 GitHub 点赞 ↗</a><a href={entry.threadUrl}>{entry.replies ? `${entry.replies} 条回复 · ` : ""}查看讨论 ↗</a></div></div></article>)}</details>}
  </div> : null}
</section>
