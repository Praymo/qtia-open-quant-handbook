---
import Layout from '../layouts/Layout.astro';
import Badges from '../components/Badges.astro';
import Icon from '../components/Icon.astro';
import { allQuestions, newest, categories, weekName } from '../lib/catalog';
import { url } from '../lib/site';
const questions = await allQuestions();
const weeks = [...new Set(questions.map(q => q.data.week))].sort((a, b) => b - a);
const latestWeek = weeks[0];
---
<Layout title="开放量化面试手册">
  <div class="eyebrow"><span>量化面试题库</span></div>
  <section class="intro">
    <h1>量化面试题，<br/><span class="accent">不止一种解法。</span></h1>
    <p class="lead">题目由 QTIA 社团整理分享，作为中英双语的开放题库，也欢迎提交证明、推导、代码和衍生问题。</p>
    <div class="actions"><a class="button primary" href={url('/questions/')}>浏览题库 <span aria-hidden="true">→</span></a></div>
  </section>
  <div class="stats" aria-label="题库概况"><div><strong>{Object.keys(categories).length}</strong><span>知识主题</span></div><div><strong>{weeks.length}</strong><span>收录周次</span></div><div><strong>{questions.length}</strong><span>收录题目</span></div></div>
  <section class="section">
    <div class="section-heading"><div><span class="small-caps">按主题浏览</span><h2>从感兴趣的主题开始</h2></div></div>
    <div class="topic-grid">{Object.entries(categories).map(([key, category]) => <a class={`topic-card topic-${key}`} href={url(`/${key}/`)}><span class="topic-symbol">{category.symbol}</span><div><h3>{category.label} <span>{category.zh}</span></h3><p>{questions.filter(q => q.data.category === key).length} 道题目</p></div><Icon name="arrow" size={17}/></a>)}</div>
  </section>
  <section class="section latest-section" aria-label="最近更新"><div class="section-heading"><div><span class="small-caps">最近更新</span><h2>最新收录 <span class="inline-meta" data-current-week aria-live="polite">{weekName(latestWeek)}</span></h2></div><a class="text-link" href={url('/questions/')}>全部题目 <span aria-hidden="true">→</span></a></div>
    <div class="latest-carousel">
      {weeks.map((week, index) => <div class="latest-track" data-week-panel data-week-name={weekName(week)} tabindex="0" aria-label={`${weekName(week)}题目，左右滚动查看更多`} hidden={index > 0}>
        {questions.filter(question => question.data.week === week).sort(newest).map(question => <a class="latest-card" href={url(`/questions/${question.data.id}/`)} aria-label={`阅读 ${question.data.id} ${question.data.title}`}><span class="latest-card-id mono">{question.data.id}</span><h3>{question.data.title}</h3><p class="latest-card-en">{question.data.titleEn}</p><p class="latest-card-summary">{question.data.summary}</p><Badges question={question}/><span class="latest-card-arrow" aria-hidden="true">↗</span></a>)}
      </div>)}
      <div class="latest-controls"><button type="button" data-week-direction="newer" aria-label="查看较新的一周" disabled>←</button><button type="button" data-week-direction="older" aria-label="查看更早的一周" disabled={weeks.length < 2}>→</button></div>
    </div>
  </section>
  <section class="contribute-strip"><Icon name="branch" size={28}/><div><h2>想分享一道题，或补上一种解法？</h2></div><a class="text-link" href={url('/contributing/')}>查看提交方法 <span aria-hidden="true">↗</span></a></section>
</Layout>
<script>
  const carousel = document.querySelector('.latest-carousel');
  const panels = [...(carousel?.querySelectorAll<HTMLElement>('[data-week-panel]') ?? [])];
  const currentWeek = document.querySelector<HTMLElement>('[data-current-week]');
  const newer = carousel?.querySelector<HTMLButtonElement>('[data-week-direction="newer"]');
  const older = carousel?.querySelector<HTMLButtonElement>('[data-week-direction="older"]');
  let active = 0;
  function showWeek(index: number) {
    if (index < 0 || index >= panels.length) return;
    active = index;
    panels.forEach((panel, i) => { panel.hidden = i !== active; });
    if (currentWeek) currentWeek.textContent = panels[active].dataset.weekName ?? '';
    if (newer) newer.disabled = active === 0;
    if (older) older.disabled = active === panels.length - 1;
  }
  newer?.addEventListener('click', () => showWeek(active - 1));
  older?.addEventListener('click', () => showWeek(active + 1));
</script>
