---
import Layout from '../layouts/Layout.astro';
import QuestionList from '../components/QuestionList.astro';
import Notice from '../components/Notice.astro';
import Icon from '../components/Icon.astro';
import { allQuestions, newest, categories, weekLabel } from '../lib/catalog';
import { url, repoUrl } from '../lib/site';
const questions = await allQuestions();
const weeks = [...new Set(questions.map(q => q.data.week))];
const latestWeek = Math.max(...weeks);
---
<Layout title="开放量化面试手册">
  <div class="eyebrow"><span>THE OPEN HANDBOOK</span><span class="edition">2026 · 秋季</span></div>
  <section class="intro">
    <h1>把每周的好问题，<br/><span class="accent">变成共同的知识。</span></h1>
    <p class="lead">QTIA CUHK(SZ) Open Quant Interview Handbook is a community-maintained collection of quantitative interview questions.</p>
    <p class="intro-zh">从每周一题开始，积累问题、分享思路，在公开协作中不断完善。</p>
    <div class="actions"><a class="button primary" href={url('/questions/')}>浏览题库 <span aria-hidden="true">→</span></a><a class="button" href={repoUrl}><Icon name="github"/>Star on GitHub <Icon name="arrow" size={14}/></a></div>
  </section>
  <div class="stats" aria-label="知识库概况"><div><strong>{String(questions.length).padStart(2, '0')}</strong><span>收录题目 <small>Problems</small></span></div><div><strong>{String(weeks.length).padStart(2, '0')}</strong><span>每周归档 <small>Weeks</small></span></div><div><strong>{String(Object.keys(categories).length).padStart(2, '0')}</strong><span>知识主题 <small>Topics</small></span></div><div class="stats-note"><Icon name="branch" size={22}/><span>多种解法，共同维护<small>Every contribution has a history.</small></span></div></div>
  <section class="section">
    <div class="section-heading"><div><span class="small-caps">EXPLORE BY TOPIC</span><h2>从感兴趣的主题开始</h2></div></div>
    <div class="topic-grid">{Object.entries(categories).map(([key, category]) => <a class={`topic-card topic-${key}`} href={url(`/${key}/`)}><span class="topic-symbol">{category.symbol}</span><div><h3>{category.label} <span>{category.zh}</span></h3><p>{questions.filter(q => q.data.category === key).length} 道题目</p></div><Icon name="arrow" size={17}/></a>)}</div>
  </section>
  <section class="section latest-section"><div class="section-heading"><div><span class="small-caps">LATEST QUESTIONS</span><h2>最新收录 <span class="inline-meta">Week {weekLabel(latestWeek)}</span></h2></div><a class="text-link" href={url('/questions/')}>全部题目 <span aria-hidden="true">→</span></a></div><QuestionList questions={[...questions].sort(newest).slice(0, 4)}/></section>
  <section class="contribute-strip"><Icon name="branch" size={28}/><div><h2>有解法，或发现题目有误？</h2><p>打开对应题目，可以提交解答、报告问题或修改题面。改动会通过 GitHub 审阅，作者和修订记录公开保留。</p></div><a class="text-link" href={url('/contributing/')}>查看提交方法 <span aria-hidden="true">↗</span></a></section>
  <div class="distribution-note"><span>公众号发布与传播</span><span aria-hidden="true">→</span><span>GitHub 协作与留痕</span><span aria-hidden="true">→</span><span>网站浏览与沉淀</span></div>
  <Notice/>
</Layout>
