---
import Layout from '../layouts/Layout.astro';
import QuestionList from '../components/QuestionList.astro';
import { categories, allQuestions } from '../lib/catalog';
import { url } from '../lib/site';
export function getStaticPaths() { return Object.entries(categories).map(([key, category]) => ({ params: { category: key }, props: { category, key } })); }
const { category, key } = Astro.props;
const questions = (await allQuestions()).filter(q => q.data.category === key);
---
<Layout title={`${category.label} · ${category.zh}`}><div class="eyebrow">EXPLORE BY TOPIC <span class="edition">{questions.length} PROBLEMS</span></div><h1><span class={`category-heading-symbol category-${key}`}>{category.symbol}</span>{category.label}</h1><p class="page-description">{category.zh} · {category.description}</p><div class="section-heading"><h2>收录题目</h2><a class="text-link" href={`${url('/questions/')}?category=${key}`}>进一步筛选 →</a></div><QuestionList questions={questions}/></Layout>
