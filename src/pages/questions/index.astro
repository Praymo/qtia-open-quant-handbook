---
import Layout from '../../layouts/Layout.astro';
import QuestionList from '../../components/QuestionList.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, categories, difficulties, weekName, newest } from '../../lib/catalog';
import { githubAction } from '../../lib/site';
const questions = await allQuestions();
const weeks = [...new Set(questions.map(q => q.data.week))].sort((a, b) => a - b);
---
<Layout title="全部题目">
  <div class="eyebrow">题库 <span class="edition">{questions.length} 道题目</span></div><h1>全部题目</h1><p class="page-description">按主题、难度和周次，找到你的下一个问题。</p>
  <form id="filters" class="filters" aria-label="题目筛选" hidden>
    <label>周次<select name="week"><option value="">全部周次</option>{weeks.map(week => <option value={week}>{weekName(week)}</option>)}</select></label>
    <label>Category · 主题<select name="category"><option value="">全部主题</option>{Object.entries(categories).map(([key, item]) => <option value={key}>{item.label} / {item.zh}</option>)}</select></label>
    <label>Difficulty · 难度<select name="difficulty"><option value="">全部难度</option>{Object.entries(difficulties).map(([key, label]) => <option value={key}>{key} · {label}</option>)}</select></label>
    <label>Origin · 来源<select name="origin"><option value="">All · 全部</option><option value="official">QTIA Official</option><option value="community">Community</option></select></label>
    <div class="filter-bottom"><p id="result-count" role="status" aria-live="polite">显示 {questions.length} 道题目</p><button type="reset" class="reset-button">重置筛选</button><label class="sort-label">排序<select name="sort"><option value="newest">最新收录</option><option value="week">周次顺序</option><option value="difficulty">难度递增</option></select></label></div>
  </form>
  <noscript><p class="notice">筛选需要 JavaScript。你仍可阅读所有题目，或通过侧栏进入分类与周归档。</p></noscript>
  <QuestionList questions={[...questions].sort(newest)}/>
  <div id="empty-results" class="empty-state" hidden><span class="empty-symbol">∅</span><h2 id="empty-title">暂时没有符合条件的题目</h2><p id="empty-description">试试减少筛选条件，或重置后重新浏览。</p><button class="button" id="empty-reset">重置筛选</button><a class="button" id="community-submit" href={githubAction('question-proposal')} hidden>提交社区题目 ↗</a></div>
  <section class="contribute-strip"><Icon name="branch" size={28}/><div><h2>想分享一道社区题目？</h2><p>直接贴题面和你的建议；编号、翻译与排版由维护者处理。</p></div><a class="text-link" href={githubAction('question-proposal')}>提交社区题目 →</a></section>
  <script>
    import { filterAndSort } from '../../lib/filter.mjs';
    const form = document.querySelector<HTMLFormElement>('#filters')!;
    const list = document.querySelector<HTMLElement>('.question-list')!;
    const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-question]'));
    const records = rows.map(row => ({ id: row.dataset.id!, category: row.dataset.category!, week: Number(row.dataset.week), difficulty: row.dataset.difficulty!, origin: row.dataset.origin!, date: row.dataset.date!, tags: JSON.parse(row.dataset.tags!) as string[] }));
    const names = ['week', 'category', 'difficulty', 'origin', 'sort'];
    function controls() { return Object.fromEntries(new FormData(form)) as Record<string, string>; }
    function apply(syncUrl = true) {
      const values = controls();
      const result = filterAndSort(records, values);
      rows.forEach(row => { row.hidden = !result.some(item => item.id === row.dataset.id); });
      result.forEach(item => list.append(rows.find(row => row.dataset.id === item.id)!));
      document.querySelector('#result-count')!.textContent = `显示 ${result.length} / ${rows.length} 道题目`;
      (document.querySelector('#empty-results') as HTMLElement).hidden = result.length > 0;
      const noCommunityYet = values.origin === 'community' && !records.some(item => item.origin === 'community');
      document.querySelector('#empty-title')!.textContent = noCommunityYet ? '社区题目暂未收录' : '暂时没有符合条件的题目';
      document.querySelector('#empty-description')!.textContent = noCommunityYet ? '你可以提交第一道社区题目。' : '试试减少筛选条件，或重置后重新浏览。';
      (document.querySelector('#community-submit') as HTMLElement).hidden = !noCommunityYet;
      if (syncUrl) {
        const query = new URLSearchParams();
        names.forEach(name => { if (values[name] && !(name === 'sort' && values[name] === 'newest')) query.set(name, values[name]); });
        history.replaceState(null, '', `${location.pathname}${query.size ? '?' + query : ''}`);
      }
    }
    function restore() {
      const query = new URLSearchParams(location.search);
      names.forEach(name => { const control = form.elements.namedItem(name) as HTMLSelectElement; const value = query.get(name) || (name === 'sort' ? 'newest' : ''); control.value = Array.from(control.options).some(option => option.value === value) ? value : control.options[0].value; });
      apply(false);
    }
    form.hidden = false;
    restore();
    form.addEventListener('change', () => apply());
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('reset', () => queueMicrotask(() => apply()));
    document.querySelector('#empty-reset')?.addEventListener('click', () => form.reset());
    window.addEventListener('popstate', restore);
  </script>
</Layout>
