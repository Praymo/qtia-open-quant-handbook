---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Badges from '../../components/Badges.astro';
import Notice from '../../components/Notice.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, weekLabel, weekName } from '../../lib/catalog';
import { url, repoUrl, githubAction } from '../../lib/site';
export async function getStaticPaths() { return (await allQuestions()).map(question => ({ params: { id: question.data.id }, props: { question } })); }
const { question } = Astro.props;
const q = question.data;
const { Content } = await render(question);
const solutions = (await getCollection('solutions', item => item.data.question.id === question.id)).sort((a, b) => a.data.order - b.data.order || a.data.date.localeCompare(b.data.date) || a.id.localeCompare(b.id));
const renderedSolutions = await Promise.all(solutions.map(async solution => ({ ...solution, ...await render(solution) })));
const questions = await allQuestions();
const index = questions.findIndex(item => item.id === question.id);
const previous = questions[index - 1];
const next = questions[index + 1];
const source = question.filePath!;
---
<Layout title={`${q.id} ${q.title}`} description={q.summary}>
  <nav class="breadcrumbs" aria-label="面包屑"><a href={url('/questions/')}>题库</a><span>/</span><a href={url(`/week/${weekLabel(q.week)}/`)}>{weekName(q.week)}</a><span>/</span><span>{q.id}</span></nav>
  <div class="eyebrow problem-number">PROBLEM {q.id}</div><h1 class="problem-title">{q.title}</h1><p class="problem-english">{q.titleEn}</p>
  <Badges question={question}/><div class="tags">{q.tags.map(tag => <a href={`${url('/questions/')}?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
  <div class="problem-layout"><article class="problem-article"><section aria-labelledby="statement"><h2 class="article-section-title" id="statement"><span>01</span>题目 <small>Problem statement</small></h2><div class="prose"><Content/></div></section>
    {q.contributors.length > 0 && <p class="attribution">题目贡献：{q.contributors.map(username => <a href={`https://github.com/${username}`}>@{username} </a>)}</p>}
    <section class="solutions-section" aria-labelledby="solutions"><h2 class="article-section-title" id="solutions"><span>02</span>社区解答 <small>{solutions.length}</small></h2><p class="section-description">欢迎不同方法。每份解答都可以通过 Pull Request 被讨论、验证和改进。</p>
      {renderedSolutions.length ? renderedSolutions.map(({ data, Content, filePath }, i) => <article class="solution" id={`solution-${i + 1}`}><span class="small-caps">{data.method}</span><h3>解法 {i + 1} — {data.title}</h3><p class="attribution">贡献者：{data.contributors.map(username => <a href={`https://github.com/${username}`}>@{username} </a>)}<span>· {data.date}</span></p><div class="prose"><Content/></div><a class="text-link" href={githubAction('edit', filePath!)}>修改这份解答 ↗</a><a class="solution-history" href={githubAction('history', filePath!)}>查看修订历史 ↗</a></article>) : <div class="empty-state solution-empty"><Icon name="branch" size={26}/><h3>暂无社区解答</h3><p>欢迎提交推导、证明或模拟，并说明如何验证。</p><a class="button primary" href={githubAction('solution', '', q.id)}>提交第一份解答 <span aria-hidden="true">↗</span></a></div>}
    </section><Notice/>
  </article><aside class="problem-aside"><p class="nav-label">本页内容</p><a href="#statement">题目</a><a href="#solutions">社区解答</a><div class="aside-rule"></div><p class="nav-label">参与这道题</p><a class="button primary" href={githubAction('solution', '', q.id)}>提交解答 <Icon name="arrow" size={14}/></a><a href={githubAction('issue', '', q.id)}>报告问题 <Icon name="arrow" size={14}/></a><a href={githubAction('edit', source)}>编辑题目 <Icon name="arrow" size={14}/></a><a href={repoUrl}>在 GitHub 收藏项目 <Icon name="star" size={14}/></a><p class="aside-caption">提交解答或勘误后，维护者会在 GitHub 上审阅。</p></aside></div>
  <nav class="previous-next" aria-label="题目导航">{previous ? <a href={url(`/questions/${previous.data.id}/`)}><span>← 上一题 · {previous.data.id}</span><strong>{previous.data.title}</strong></a> : <span/>}{next && <a href={url(`/questions/${next.data.id}/`)}><span>下一题 · {next.data.id} →</span><strong>{next.data.title}</strong></a>}</nav>
</Layout>
