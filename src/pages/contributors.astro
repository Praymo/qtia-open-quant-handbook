---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import directory from '../data/contributors.json';
import { allQuestions } from '../lib/catalog';
const questions = await allQuestions();
const solutions = await getCollection('solutions');
const names = new Set<string>([...(directory as { username: string }[]).map(item => item.username), ...questions.flatMap(q => q.data.contributors), ...solutions.flatMap(s => s.data.contributors)]);
const contributors = [...names].sort((a, b) => a.localeCompare(b));
---
<Layout title="贡献者">
  <div class="eyebrow">COMMUNITY</div>
  <h1>贡献者</h1>
  <div class="contributor-avatars" aria-label="GitHub 贡献者">
    {contributors.map(username => <a href={`https://github.com/${username}`} aria-label={`查看 @${username} 的 GitHub 主页`} title={`@${username}`}><img src={`https://github.com/${username}.png?size=128`} alt="" width="64" height="64" loading="lazy"/></a>)}
  </div>
</Layout>
