---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import results from '../../data/feedback-results.json';
import discussionResults from '../../data/discussion-results.json';
import { allQuestions, weekLabel, weekName } from '../../lib/catalog';
import { feedbackGroup } from '../../lib/feedback';
import { repoUrl, url } from '../../lib/site';

type FeedbackResult = { week: number; total: number; questions: { key: string; options: { label: string; votes: number }[] }[] };
type DiscussionResult = { number: number; title: string; url: string; commentCount: number; comments: { author: string; body: string; url: string; createdAt: string }[] };
export async function getStaticPaths() {
  const weeks = [...new Set((await allQuestions()).map(question => question.data.week))];
  return weeks.map(week => ({ params: { week: weekLabel(week) }, props: { group: feedbackGroup(week) } }));
}
const { group } = Astro.props;
const result = (results.weeks as FeedbackResult[]).find(item => item.week === group.week);
const discussion = (discussionResults.discussions as DiscussionResult[]).find(item => item.number === group.discussion);
---
<Layout title={`${weekName(group.week)}反馈`}>
  <nav class="breadcrumbs" aria-label="面包屑"><a href={url('/feedback/')}>反馈专区</a><span>/</span><span>{weekName(group.week)}</span></nav>
  <div class="eyebrow">反馈专区</div>
  <h1>{weekName(group.week)} · 题目反馈</h1>
  {group.questions.length ? <>
    <p class="page-description">三道题一次填完，再到 GitHub 确认提交。难度、题量和讲解需求的结果会公开显示在这里。</p>
    <form id="weekly-feedback-form" class="weekly-feedback-form" data-week={group.week} data-week-name={weekName(group.week)} data-repo-url={repoUrl}>
      {group.questions.map((item, index) => <fieldset class="feedback-question">
        <legend><span class="mono">{String(index + 1).padStart(2, '0')}</span><span>{item.title}</span></legend>
        <p>{item.question}</p>
        <div class="feedback-choices">{item.options.map(option => <label><input type="radio" name={item.key} value={option} required/><span>{option}</span></label>)}</div>
      </fieldset>)}
      <div class="feedback-submit"><button class="button primary" type="submit">带着三项反馈去 GitHub <Icon name="arrow" size={14}/></button><p>登录 GitHub 后核对内容，点“Create”完成提交。</p></div>
    </form>
    <section class="feedback-results" aria-labelledby="feedback-results-title"><div class="section-heading"><div><span class="small-caps">RESULTS</span><h2 id="feedback-results-title">当前反馈</h2></div><span class="feedback-count">{result?.total ?? 0} 人参与</span></div>
      {result?.total ? <div class="feedback-results-grid">{group.questions.map(item => { const answers = result.questions.find(answer => answer.key === item.key); return <div class="feedback-results-card"><h3>{item.title}</h3>{answers?.options.map(option => { const percent = Math.round(option.votes / result.total * 100); return <div class="poll-result"><div class="poll-result-label"><span>{option.label}</span><span>{option.votes} 人 · {percent}%</span></div><div class="poll-track"><span style={`width:${percent}%`}></span></div></div>; })}</div>; })}</div> : <p class="feedback-empty">还没有反馈，欢迎留下第一份。</p>}
      <p class="poll-help">同一位 GitHub 用户在同一周只计最近一份反馈。{results.updatedAt ? `结果更新于 ${new Date(results.updatedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' })}，约每小时刷新。` : '结果将在网站下次更新后显示。'}</p>
    </section>
  </> : <p class="page-description">这一周还没有开放反馈。你可以先浏览本周题目。</p>}
  <section class="feedback-discussions" aria-labelledby="discussion-title"><div class="section-heading"><div><span class="small-caps">COMMUNITY</span><h2 id="discussion-title">自由讨论</h2></div></div>
    <p>想聊题目、分享思路或提建议，都可以写在同一个讨论帖里。</p>
    {discussion ? <article class="discussion-preview discussion-single"><div><h3><a href={discussion.url}>{discussion.title} ↗</a></h3><p>{discussion.commentCount} 条留言</p></div>{discussion.comments.length > 0 && <ul>{discussion.comments.map(comment => <li><a href={comment.url}><strong>@{comment.author}</strong> {comment.body}</a></li>)}</ul>}<a class="text-link" href={discussion.url}>参与讨论 →</a></article> : <p class="discussion-empty">本周讨论即将开放。</p>}
  </section>
  <p class="poll-back"><a class="text-link" href={url(`/week/${weekLabel(group.week)}/`)}>← 返回{weekName(group.week)}题目</a></p>
</Layout>
<script>
  document.querySelector<HTMLFormElement>('#weekly-feedback-form')?.addEventListener('submit', event => {
    const form = event.currentTarget as HTMLFormElement;
    event.preventDefault();
    if (!form.reportValidity()) return;
    const answers = new FormData(form);
    const week = Number(form.dataset.week);
    const weekName = form.dataset.weekName ?? '';
    const difficulty = String(answers.get('difficulty') ?? '');
    const volume = String(answers.get('volume') ?? '');
    const explanation = String(answers.get('explanation') ?? '');
    const marker = JSON.stringify({ week, difficulty, volume, explanation });
    const body = `<!-- qtia-weekly-feedback:v1\n${marker}\n-->\n\n## ${weekName}反馈\n\n- 习题难度：${difficulty}\n- 习题量：${volume}\n- 答案与讲解：${explanation}`;
    const title = `QTIA ${weekName}反馈`;
    window.location.href = `${form.dataset.repoUrl}/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
  });
</script>
