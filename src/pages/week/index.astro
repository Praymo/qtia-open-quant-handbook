---
import Layout from '../../layouts/Layout.astro';
import { allQuestions, weekLabel, weekName, categories } from '../../lib/catalog';
import { url } from '../../lib/site';
const questions = await allQuestions();
const weeks = [...new Set(questions.map(q => q.data.week))].sort((a, b) => b - a);
---
<Layout title="每周归档"><div class="eyebrow">每周归档 <span class="edition">已收录 {weeks.length} 周</span></div><h1>按周浏览题目</h1><p class="page-description">选择一周，查看这一期收录的题目。</p><div class="week-cards">{weeks.map(week => { const items = questions.filter(q => q.data.week === week); return <a class="week-card" href={url(`/week/${weekLabel(week)}/`)}><div class="week-card-label"><span class="small-caps">周次</span><strong>{weekLabel(week)}</strong></div><div><p class="small-caps">{weekName(week)} · {items[0].data.date} · {items.length} 道题目</p><h2>{items.map(q => q.data.title).join(' / ')}</h2><div class="badges">{[...new Set(items.map(q => q.data.category))].map(category => <span class={`badge category-${category}`}>{categories[category].label}</span>)}</div></div><span class="week-arrow" aria-hidden="true">↗</span></a>; })}</div></Layout>
