---
import Layout from '../layouts/Layout.astro';
import feedback from '../data/feedback.json';
import { allQuestions, weekLabel, weekName } from '../lib/catalog';
import { url } from '../lib/site';
const weeks = [...new Set((await allQuestions()).map(question => question.data.week))].sort((a, b) => b - a);
const groups = weeks.map(week => feedback.weeks.find(group => group.week === week) ?? { week, polls: [] });
---
<Layout title="反馈投票">
  <div class="eyebrow">反馈投票</div>
  <h1>按周查看反馈</h1>
  <p class="page-description">选择周次，查看题目反馈和投票结果。</p>
  <div class="week-cards">{groups.map(group => <a class="week-card" href={url(`/feedback/${weekLabel(group.week)}/`)}>
    <div class="week-card-label"><span class="small-caps">周次</span><strong>{weekLabel(group.week)}</strong></div>
    <div><h2>{weekName(group.week)}</h2><p class="poll-week-summary">{group.polls.length ? `${group.polls.length} 项反馈投票 · ${group.polls.map(poll => poll.title).join(' / ')}` : '尚未开放投票'}</p></div>
    <span class="week-arrow" aria-hidden="true">↗</span>
  </a>)}</div>
</Layout>
